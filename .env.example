# ---- Pulse environment variables ----
# This file documents every required variable. Real values live in the
# deploy platform's secret store (Render/Railway/Vercel/Atlas/Upstash) and
# in CI credentials â€” NEVER commit real values to git.

# Node
NODE_ENV=development

# Mongo
MONGO_URI=mongodb://localhost:27017/pulse

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Bcrypt cost factor (12 per PRD)
BCRYPT_ROUNDS=12

# Temporal
# Transport used by the API/workers to reach Temporal. Local default is native
# gRPC. Render Free demo sets TEMPORAL_TRANSPORT=rest and points
# TEMPORAL_REST_URL at the combined temporal-demo service, which fronts the
# workflow service with the official render-examples REST-to-gRPC proxy.
TEMPORAL_TRANSPORT=grpc
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Only used by the temporal-worker process; leave false for local loopback.
TEMPORAL_TLS=false
# --- REST transport (only when TEMPORAL_TRANSPORT=rest) ---
# TEMPORAL_REST_URL=https://<temporal-demo-service>.onrender.com
# TEMPORAL_AUTH_TOKEN=<same secret as the proxy's AUTH_TOKEN>
# TEMPORAL_REST_TIMEOUT_MS=10000

# --- temporal-demo service (Render Free; not read by docker compose) ---
# These belong to the combined Temporal demo service (infra/temporal-demo), which
# runs Temporal Server, the Pulse worker and the REST-to-gRPC proxy in one
# container. Set them in that service's environment, not in the app backend's.
# Verified against temporalio/auto-setup:1.25.2 and a real PostgreSQL server.
#
# TWO DATABASES ARE REQUIRED. DBNAME and VISIBILITY_DBNAME must be different:
# point both at the same database and the visibility migration is silently
# skipped (the core store already advanced the shared schema_version table), so
# the executions_visibility table is never created and workflow queries fail.
# Create both databases in Neon up front, owned by POSTGRES_USER.
#
# SKIP_DB_CREATE=true is required for an existing Neon database: without it
# startup issues CREATE DATABASE on every boot, which fails outright if the
# Neon role lacks CREATEDB. It only skips database creation - the schema
# migrations still run, so the databases must already exist.
DB=postgres12
DB_PORT=5432
DBNAME=temporal_core
VISIBILITY_DBNAME=temporal_visibility
SKIP_DB_CREATE=true
# POSTGRES_SEEDS=<neon-host>          # host only: no scheme, no :port
# POSTGRES_USER=<neon-role>
# POSTGRES_PWD=<neon-password>
# Schema setup TLS (temporal-sql-tool, run by /etc/temporal/auto-setup.sh):
POSTGRES_TLS_ENABLED=true
POSTGRES_TLS_DISABLE_HOST_VERIFICATION=false
# POSTGRES_TLS_SERVER_NAME=<neon-host>
# Running server TLS (rendered into /etc/temporal/config/docker.yaml). These are
# separate variables: POSTGRES_TLS_ENABLED does not reach the server and
# SQL_TLS_ENABLED does not reach the schema tool, so both are required.
SQL_TLS_ENABLED=true
SQL_HOST_VERIFICATION=true
# SQL_HOST_NAME=<neon-host>
# SQL_CA=                          # leave empty: Neon is publicly trusted and
#                                   # an empty CA falls back to the OS trust store
ENABLE_ES=false
# BIND_ON_IP / TEMPORAL_BROADCAST_ADDRESS are deliberately NOT set here.
# The infra/temporal-demo image runs a single Temporal node in a single
# container and entrypoint.sh pins its membership to 127.0.0.1. Temporal reads
# the ringpop listen address from bindOnIP, records broadcastAddress in the
# cluster_membership table and bootstraps ringpop from that table, so a single
# node only forms a ring when all three are the same connectable address.
# 0.0.0.0 is not connectable: the node would have to advertise Render's
# ephemeral private IP, cannot reach it, and shuts down with
# "Current reachable members ... addresses: []". Any value set here is ignored
# and logged at boot; check the result with: <image> --print-membership
TEMPORAL_NAMESPACE=default
TEMPORAL_CLUSTER_HOST=127.0.0.1
# PORT=8080                        # must be set explicitly; Render defaults to
#                                   # 10000, which collides with the REST proxy
# The visibility schema also runs CREATE EXTENSION btree_gin. It is a trusted
# extension on PostgreSQL 13+, so the Neon database owner can install it.

# Process supervisor: which processes the backend container starts.
# Unset = all four (api, temporal-worker, ai-worker, notifications).
# PULSE_PROCESSES=api,ai-worker,notifications

# AI incident analysis â€” provider-agnostic cost controls
# Provider: "groq" (free default) or "claude". Swap models via AI_MODEL.
AI_PROVIDER=groq
# Master kill-switch; false hard-stops all AI analysis
AI_ENABLED=true
# Per-process daily cap on provider calls (0 disables analysis entirely)
AI_DAILY_CALL_CAP=10
# Per-call timeout (ms); on timeout the summary stays null + 1 retry
AI_TIMEOUT_MS=10000
# Short-form model for the active provider (leave empty for provider default:
# openai/gpt-oss-120b on Groq, claude-sonnet-4-20250514 on Claude)
AI_MODEL=
# Max output tokens per analysis (keeps free tiers well under limits)
AI_MAX_TOKENS=700
AI_ANALYSIS_QUEUE_NAME=pulse-ai-analysis

# Groq (free tier â€” https://console.groq.com/keys, no credit card needed)
GROQ_API_KEY=

# Anthropic (only needed when AI_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Resend (email notifications)
RESEND_API_KEY=
# From address used in notification emails
EMAIL_FROM=Pulse <alerts@pulse.dev>
# Notification queue
NOTIFY_QUEUE_NAME=pulse-notifications
EMAIL_MAX_ATTEMPTS=5
EMAIL_BACKOFF_MS=5000

# AES-256-GCM encryption key for auth tokens at rest (32 bytes, base64)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# API base URL used in notification templates
APP_BASE_URL=http://localhost:3000

# Backend port for local dev
PORT=4000

# ---- Docker Compose deployment (docker-compose.yml) ----
# docker compose reads this same .env file for interpolation. Fill these in,
# then:  docker compose up -d --build
#
# JWT_SECRET / ENCRYPTION_KEY are required there (no safe default).
# Generate ENCRYPTION_KEY with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Host ports to remap (optional)
PULSE_FRONTEND_PORT=3000
PULSE_API_PORT=4000
# Public origin of the web app (used in notification email links)
APP_BASE_URL=http://localhost:3000
# If the browser should call the API on a different origin, set this to the
# public backend base URL and rebuild the frontend (--build-arg NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_API_URL=
# Internal proxy target for the frontend container (Next rewrite of /api/*).
# Only needed when running the frontend container separately; defaults to http://localhost:4000.
BACKEND_INTERNAL_URL=http://backend:4000

# ---- Optional demo seeder (scripts/seed-demo.js) ----
PULSE_ADMIN_EMAIL=
PULSE_ADMIN_PASSWORD=

