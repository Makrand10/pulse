# ---- Pulse environment variables ----
# This file documents every required variable. Real values live in the
# deploy platform's secret store (Render/Railway/Vercel/Atlas/Upstash) and
# in CI credentials — NEVER commit real values to git.

# Node
NODE_ENV=development

# Mongo
MONGO_URI=mongodb://localhost:27017/pulse

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Bcrypt cost factor (12 per PRD)
BCRYPT_ROUNDS=12

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Anthropic (LangGraph root-cause analysis)
ANTHROPIC_API_KEY=

# Resend (email notifications)
RESEND_API_KEY=

# AES-256-GCM encryption key for auth tokens at rest (32 bytes, base64)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# API base URL used in notification templates
APP_BASE_URL=http://localhost:3000

# Backend port for local dev
PORT=4000
